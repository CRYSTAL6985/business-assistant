# Copy this file to .env and fill it in. .env is never committed.

PORT=3000
DB_FILE=data/assistant.db

# Any OpenAI-compatible chat API works. Free option: OpenRouter (https://openrouter.ai/keys)
# with a model whose id ends in ":free" — see https://openrouter.ai/models?q=free
# Leave AI_API_KEY empty to run in offline mode (keyword answers from the FAQ list).
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenRouter blocks Iranian IPs. To send AI calls through a local VPN proxy (v2rayN etc.),
# uncomment both lines. Node 24 reads them natively; no code change needed.
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://127.0.0.1:10808
